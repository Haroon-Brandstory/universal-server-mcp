MCP_API_KEY=change-me-to-a-long-random-secret
# Separate key for OAuth consent approval (required for remote OAuth)
MCP_OAUTH_OPERATOR_KEY=change-me-oauth-operator-secret
# Dual-auth write approvals — humans only, at /operators. Never give to AI.
MCP_OPERATOR_TOKEN=change-me-operator-approval-password-16+
# Dev/tests only — auto-approve new tickets. NEVER set in production.
# MCP_ALLOW_DEV_SELF_APPROVE=true

MCP_POLICY_PATH=./config/policy.yaml
MCP_AUDIT_PATH=./logs/audit.jsonl
MCP_OAUTH_STORE_PATH=./data/oauth-store.json
MCP_RATE_LIMIT_PER_MIN=60
MCP_KILL_SWITCH=0

# Transport: stdio (Cursor local) | http (ChatGPT / Claude / Grok / remote)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=7337
# Comma-separated Host allowlist extras (exact). For ngrok/cloudflared set:
MCP_ALLOW_TUNNEL_HOSTS=1
# MCP_ALLOWED_HOSTS=my-tunnel.example.com

# Public HTTPS origin (ngrok) — required for grok.com OAuth connectors
# MCP_PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.dev
# MCP_OAUTH_GROK_CLIENT_ID=global-server-mcp-grok
# Extra exact redirect URIs (comma-separated), in addition to policy.oauth.allowed_redirect_uris
# MCP_OAUTH_ALLOWED_REDIRECTS=
# Dynamic client registration (also requires policy.oauth.allow_dynamic_registration: true)
# MCP_OAUTH_ALLOW_DCR=0

# GitOps — prefer GitHub App (installation-scoped). Never put tokens in tool args.
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Or PEM with escaped newlines:
# GITHUB_APP_PRIVATE_KEY=
# Local-only fallback (less preferred than GitHub App):
# GITHUB_TOKEN=

# BuildOps
# MCP_BUILD_WORK_ROOT=./data/build-workspaces
# Prefer Docker. Process runner only when policy.build.allow_process_runner=true (non-prod).

# ServerOps — registry path + per-server key/known_hosts env names from servers.yaml
# MCP_SERVERS_PATH=./config/servers.yaml
# MCP_SERVER_STAGING_KEY_PATH=/secure/keys/mcp-monitor-staging
# MCP_SERVER_STAGING_KNOWN_HOSTS=/secure/known_hosts/staging

# DatabaseOps — registry path; values referenced from config/databases.yaml
# MCP_DATABASES_PATH=./config/databases.yaml
# MCP_DB_BE_PG_HOST=127.0.0.1
# MCP_DB_BE_PG_PORT=5432
# MCP_DB_BE_PG_DATABASE=strapi
# MCP_DB_BE_PG_READ_USER=mcp_readonly
# MCP_DB_BE_PG_READ_PASSWORD=
# MCP_DB_BE_PG_WRITE_USER=mcp_migrator
# MCP_DB_BE_PG_WRITE_PASSWORD=
# MCP_DB_BE_PG_SSL=0
# Optional live test smoke: TEST_DATABASE_URL= / TEST_MYSQL_URL=

# SecurityOps
# MCP_SECURITY_TARGETS_PATH=./config/security.yaml
# MCP_SECURITY_FINDINGS_PATH=./data/security-findings.json
# MCP_SECURITY_FORCE_MOCK=1

# DeployOps
# MCP_DEPLOYMENTS_PATH=./config/deployments.yaml
# MCP_DEPLOY_HISTORY_PATH=./data/deploy-history.json
# MCP_DEPLOY_FORCE_MOCK=1

# Platform
# MCP_PROJECTS_PATH=./config/projects.yaml
# MCP_STACK_PROFILES_PATH=./config/stack-profiles.yaml
# MCP_METRICS_PATH=./logs/metrics.jsonl
# MCP_METRICS_ENABLED=1
