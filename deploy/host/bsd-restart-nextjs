#!/usr/bin/env bash
# Restart Brandstory FE PM2 app from the FE project tree.
# Intended to run as bsdglobal (via bsd-mcp-ctl-handle). No arbitrary shell from MCP.
set -euo pipefail

FE_ROOT="${BSD_FE_ROOT:-/var/www/html/global-brandstory}"
APP_NAME="${MCP_PM2_NEXTJS_NAME:-frontend-nextjs}"
APP_USER="${BSD_PM2_USER:-bsdglobal}"
HOME_DIR="$(getent passwd "${APP_USER}" | cut -d: -f6)"
export HOME="${HOME_DIR}"
export PM2_HOME="${HOME_DIR}/.pm2"

cd "${FE_ROOT}"

PM2="$(command -v pm2 || true)"
if [[ -z "${PM2}" ]]; then
  for c in "${HOME_DIR}"/.nvm/versions/node/*/bin/pm2 /usr/bin/pm2 /usr/local/bin/pm2; do
    if [[ -x "${c}" ]]; then PM2="${c}"; break; fi
  done
fi
if [[ -z "${PM2}" || ! -x "${PM2}" ]]; then
  echo "bsd-restart-nextjs: pm2 not found for ${APP_USER}" >&2
  exit 127
fi

# Prefer explicit name; else match pm2 process whose cwd is FE_ROOT
if "${PM2}" describe "${APP_NAME}" >/dev/null 2>&1; then
  exec "${PM2}" restart "${APP_NAME}" --update-env
fi

# Fallback: first online app with matching cwd (jq-free)
mapfile -t lines < <("${PM2}" jlist 2>/dev/null | tr '{' '\n' | grep -E "\"name\"|\"pm_cwd\"" || true)
# Simpler fallback: restart by id 0 only if name check failed — too dangerous.
# Instead scan with node if available:
if command -v node >/dev/null 2>&1; then
  NAME="$(
    FE_ROOT="${FE_ROOT}" PM2_HOME="${PM2_HOME}" "${PM2}" jlist 2>/dev/null | node -e '
      let s=""; process.stdin.on("data",d=>s+=d); process.stdin.on("end",()=>{
        try {
          const apps=JSON.parse(s||"[]");
          const root=process.env.FE_ROOT;
          const hit=apps.find(a => (a.pm2_env&&String(a.pm2_env.pm_cwd||"").startsWith(root)));
          if (hit) process.stdout.write(hit.name||"");
        } catch {}
      });
    '
  )" || true
  if [[ -n "${NAME}" ]]; then
    exec "${PM2}" restart "${NAME}" --update-env
  fi
fi

echo "bsd-restart-nextjs: no PM2 app named ${APP_NAME} and none with cwd under ${FE_ROOT}" >&2
"${PM2}" list >&2 || true
exit 1
