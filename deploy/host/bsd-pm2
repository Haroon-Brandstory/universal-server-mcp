#!/usr/bin/env bash
# Optional host-side helper. Container prefers /usr/local/bin/pm2 + PM2_HOME=/pm2-home.
set -euo pipefail
export HOME="${BSD_PM2_HOME_USER:-${HOME:-/home/bsdglobal}}"
export PM2_HOME="${PM2_HOME:-${HOME}/.pm2}"
if [[ -x /usr/local/bin/pm2 ]]; then
  exec /usr/local/bin/pm2 "$@"
fi
if command -v pm2 >/dev/null 2>&1; then
  exec pm2 "$@"
fi
echo "bsd-pm2: pm2 not found" >&2
exit 127
