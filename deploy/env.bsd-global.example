# Copy to /etc/bsd-global-mcp/env on the DigitalOcean VPS (chmod 600).
# This gateway is for brandstoryglobal.com FE+BE only.

MCP_TRANSPORT=http
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=7337
MCP_PUBLIC_BASE_URL=https://mcp.brandstoryglobal.com
MCP_ALLOWED_HOSTS=mcp.brandstoryglobal.com
MCP_ALLOW_TUNNEL_HOSTS=0
MCP_TRUST_PROXY=1

MCP_API_KEY=change-me-long-random-bot-key
MCP_OAUTH_OPERATOR_KEY=change-me-oauth-consent-key
# Dual-auth write approvals — humans at https://mcp.brandstoryglobal.com/operators
MCP_OPERATOR_TOKEN=change-me-operator-approval-password-16+
# NEVER enable on this VPS:
# MCP_ALLOW_DEV_SELF_APPROVE=true

# Paths inside the container (compose also sets these)
MCP_POLICY_PATH=/app/config/policy.yaml
MCP_PROJECTS_PATH=/app/config/projects.yaml
MCP_SERVERS_PATH=/app/config/servers.yaml
MCP_DATABASES_PATH=/app/config/databases.yaml
MCP_SECURITY_TARGETS_PATH=/app/config/security.yaml
MCP_DEPLOYMENTS_PATH=/app/config/deployments.yaml
MCP_STACK_PROFILES_PATH=/app/config/stack-profiles.yaml
MCP_AUDIT_PATH=/data/logs/audit.jsonl
MCP_METRICS_PATH=/data/logs/metrics.jsonl
MCP_OAUTH_STORE_PATH=/data/oauth-store.json
MCP_BUILD_WORK_ROOT=/data/build-workspaces
MCP_RATE_LIMIT_PER_MIN=60
MCP_KILL_SWITCH=0
MCP_METRICS_ENABLED=1

# Host PM2 / npm (Docker). Run: sudo bash deploy/host/install-pm2-bridge.sh
# Then set paths from that script output (compose also mounts /host-nodejs/bin).
MCP_PM2_BIN=/usr/local/sbin/bsd-pm2
MCP_NPM_BIN=/host-nodejs/bin/npm
MCP_PM2_NEXTJS_NAME=frontend-nextjs
MCP_PM2_STRAPI_NAME=strapi-backend
# HOME + PM2_HOME also set by compose from deploy/docker/.env.pm2

# Optional Strapi PG read (env names from databases.yaml)
# MCP_DB_BE_PG_HOST=127.0.0.1
# MCP_DB_BE_PG_PORT=5432
# MCP_DB_BE_PG_DATABASE=strapi
# MCP_DB_BE_PG_READ_USER=mcp_readonly
# MCP_DB_BE_PG_READ_PASSWORD=
# MCP_DB_BE_PG_SSL=0
